# =============================================================================
# RentMate — commit SOURCE + docs + lockfiles. Never commit secrets or builds.
# Env templates: **/.env.example only — see docs/demo-user-guide.md
# =============================================================================

# --- Dependencies (reinstall with npm install) ---
node_modules/

# --- Build output (regenerate with npm run build) ---
dist/
dist-ssr/
build/
coverage/

# --- Tooling cache ---
.vite/
.cache/
*.tsbuildinfo
vite.config.*.timestamp-*
.claude-replay.*
.tmp-*

# --- Secrets & environment (NEVER commit) ---
.env
.env.*
!.env.example
!**/.env.example
.env.local
.env.*.local
**/.env
**/.env.local
**/.env.*.local
.envrc
.direnv/
secrets/
*.secrets
# Known project paths (documented in docs/demo-user-guide.md)
Figma/.env
Figma/.env.local
Figma/.env.*.local
backend/.env
backend/.env.local
backend/.env.*.local
backend/server/.env
backend/server/.env.local
backend/server/.env.*.local

# --- Keys & credentials ---
*.key
*.pem
credentials.json
*-credentials.json
service-account*.json

# --- Supabase CLI (machine-local link / Docker) ---
.supabase/
**/supabase/.branches/
**/supabase/.temp/

# --- Hosting deploy cache ---
.vercel/
.netlify/

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
.agents/
.codebuddy/
.continue/
# Editor directories and files
# --- Editor (optional team settings are whitelisted) ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.cursor/

# --- OS ---
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- WorkBuddy: commit memory + skills only ---
.workbuddy-ai/*
!.workbuddy-ai/memory/
!.workbuddy-ai/skills/
