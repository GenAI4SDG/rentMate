# Copy to `.env.local` (gitignored) and fill in from your Supabase project.
#
# Supabase dashboard -> Project Settings -> API
#   Project URL   -> VITE_SUPABASE_URL
#   anon public   -> VITE_SUPABASE_ANON_KEY
#
# The anon key is PUBLIC by design; Row Level Security protects the data.
# NEVER put the service-role key in this file — it lives only in Edge Function
# secrets if you ever deploy one.
#
# Real-time AI (OpenAI) is deliberately OFF for the demo: the match narrative is
# hardcoded/cached, and the `compatibility` function no longer calls a model. So
# there is no OpenAI key to set.
#
# Leave both blank to run the demo in local mode (no backend, no sign-in email).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
