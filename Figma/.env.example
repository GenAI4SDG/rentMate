# Copy to Figma/.env.local. Restart `npm run dev` after saving.
# In production these are BUILD-TIME variables on Vercel/Render (redeploy after changing).
#
# URL — NOT on the API Keys page:
#   Dashboard → Settings → General → "Project URL" (https://xxxxx.supabase.co)
#
# Key — Settings → API Keys → tab "Legacy anon, service_role API keys":
#   Copy the long "anon" "public" key (starts with eyJ...)
#   NEVER use the secret / service_role key in the browser.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJpaste_legacy_anon_key_here

# Production: public URL of the map API (Render/Railway). Leave empty locally (/api proxy).
# VITE_MAP_API_URL=https://your-map-api.onrender.com

# GenAI: "mock" (default) = built-in rule-based placeholder, no keys needed.
# Set to "api" once your own endpoints exist (see src/lib/genai/index.ts for the contract).
# VITE_GENAI_MODE=mock
# VITE_GENAI_API_URL=https://your-project.supabase.co/functions/v1

# Show the one-click "demo owner" button on the landlord sign-in (always on in dev).
# Keep false on a public site — anyone could edit the sample listings.
# VITE_SHOW_DEMO_OWNER=false

# Map tiles (default OSM)
VITE_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_DEFAULT_LAT=22.3193
VITE_MAP_DEFAULT_LNG=114.1694
