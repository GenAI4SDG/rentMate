# Copy to Figma/.env.local (TWO lines). Restart `npm run dev` after saving.
#
# URL — NOT on the API Keys page:
#   Dashboard → rentMate Backend → Settings → General
#   Copy "Project URL" (https://xxxxx.supabase.co)
#   OR: Home → Connect → copy "Project URL"
#
# Key — Settings → API Keys:
#   Open tab "Legacy anon, service_role API keys"
#   Copy the long "anon" "public" key (starts with eyJ...)
#   Do NOT use the secret / service_role key in the browser.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJpaste_legacy_anon_key_here

# Optional: landlord UUID from `npm run seed:listings` (for List a property form)
VITE_DEMO_LANDLORD_ID=

# Map tiles (default OSM)
VITE_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_DEFAULT_LAT=22.3193
VITE_MAP_DEFAULT_LNG=114.1694
