# =============================================================================
# Server secrets — copy to backend/server/.env.local (gitignored)
#   cd backend/server && cp .env.example .env.local
# In production, set the same names as environment variables on Render/Railway.
# =============================================================================
# See docs/demo-user-guide.md (Environment files).

# --- Supabase (Project Settings → API) ---
SUPABASE_URL=https://YOUR_REF.supabase.co
SUPABASE_ANON_KEY=

# Seed + landlord writes (verifies JWTs, creates listings) —
# legacy service_role eyJ… OR sb_secret_…   (NOT sb_publishable_…)
SUPABASE_SERVICE_ROLE_KEY=

# --- Production hardening ---
# Only these browser origins may call the API (comma-separated). Empty = allow all (dev).
# CORS_ORIGINS=https://your-site.vercel.app

# Password for the seeded demo owner testing@rentmate.local (default: rentmate-testing-demo)
# SEED_LANDLORD_PASSWORD=

# --- Optional: Postgres pooler (geocode DB cache) ---
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@....pooler.supabase.com:6543/postgres

# --- OpenStreetMap (map API) ---
OSM_USER_AGENT=RentMate/1.0 (your-email@example.com)
# OSM_API_BASE_URL=http://localhost:3000
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# OVERPASS_URL=https://overpass-api.de/api/interpreter

# --- Optional: Supabase Edge Functions (analyze-agreement, rental-chatbot) ---
# OPENAI_API_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
